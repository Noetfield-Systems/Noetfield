  "title": "Noetfield UI/UX Library 2026",
  "purpose": "Single internal library for agents, LLMs, and the app to produce precise, high-grade UI/UX without inventing a design system per request.",
  "law": [
    "Model writes brief JSON only — never freeform full-page HTML for production landings.",
    "Template + style_pack own typography, spacing, radius, and section chrome.",
    "Publish fail-closed on contrast, font allowlist, H1 craft, and structure.",
    "Compliance gates are not grade. Grade is fail-closed.",
    "One order → one surface. Do not restyle unrelated surfaces for consistency."
  ],
  "links": {
    "grade_law": "docs/www/NF_UI_UX_GRADE_LAW_LOCKED_v1.md",
    "ui_checklist": "docs/www/NF_UI_BUILD_CHECKLIST_LOCKED_v1.md",
    "design_reference": "docs/DESIGN_REFERENCE_GOALS_LOCKED_v1.md",
    "golden_home_baseline": "data/www-home-golden-baseline-v1.json",
    "corporate_css": "assets/noetfield-corporate-v1.css",
    "home_css": "assets/noetfield-home-v2.css",
    "app_landing_renderer": "sites/company-new/functions/_lib/landing-html.ts",
    "app_library_module": "sites/company-new/functions/_lib/uiux-library-2026.ts",
    "skill": ".cursor/skills/SKILL-012-uiux-library-2026.md"
  },
  "composition_laws": [
    {
      "id": "one_composition",
      "rule": "First viewport reads as one composition, not a dashboard."
    },
    {
      "id": "brand_first",
      "rule": "Brand or product name is a hero-level signal, not only nav text."
    },
    {
      "id": "hero_budget",
      "rule": "First viewport: brand, one headline, one short support line, one CTA group, one dominant visual plane."
    },
    {
      "id": "no_hero_overlays",
      "rule": "No floating badges, promo stickers, or detached chips on hero media."
    },
    {
      "id": "cards_for_interaction",
      "rule": "Cards only when they contain user interaction; otherwise prefer open sections."
    },
    {
      "id": "one_job_per_section",
      "rule": "Each section: one purpose, one headline, usually one short support sentence."
    },
    {
      "id": "atmosphere",
      "rule": "Prefer gradients or subtle depth over flat single-color slabs; keep text contrast WCAG-AA."
    },
    {
      "id": "motion_intent",
      "rule": "Ship 2–3 intentional motions max; never motion noise."
    },
    {
      "id": "anti_slop",
      "rule": "Avoid purple-indigo AI defaults, cream+terracotta serif cliché, and dense broadsheet hairline layouts unless the sector pack explicitly calls for them."
    }
  ],
  "craft": {
    "h1_min_chars": 12,
    "h1_max_chars": 90,
    "tagline_preferred_min": 24,
    "tagline_preferred_max": 90,
    "summary_max_chars": 420,
    "cta_max_chars": 60,
    "cta_case": "sentence",
    "forbid_all_caps_cta": true,
    "min_text_contrast": 4.5,
    "min_muted_contrast": 3.5,
    "forbidden_filler_openers": [
      "we help companies",
      "we help businesses",
      "welcome to our website",
      "your one-stop shop"
    ],
    "forbidden_claim_classes": [
      "fake testimonials",
      "fake ratings",
      "fake certifications",
      "invented phone numbers",
      "invented emails"
    ],
    "institutional_verbs": [
      "govern",
      "commission",
      "inspect",
      "bound",
      "receipt",
      "verify",
      "deliver",
      "clarify"
    ]
  },
